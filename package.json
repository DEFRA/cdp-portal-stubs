{
  "name": "cdp-portal-stubs",
  "version": "0.0.0",
  "description": "CDP Portal Stubs",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:server",
    "build:server": "babel --delete-dir-on-start --ignore \"**/*.test.js\" --ignore \"src/__fixtures__\" --copy-files --no-copy-ignored --out-dir ./.server ./src",
    "docker:dev": "NODE_ENV=development npm run server:watch",
    "dev": "NODE_ENV=development npm run server:watch",
    "dev:debug": "NODE_ENV=development npm run server:debug",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,md,json,config.js,test.js}\"",
    "postinstall": "npm run setup:husky",
    "lint": "npm run lint:js",
    "lint:fix": "eslint . --fix",
    "lint:js": "eslint .",
    "security-audit": "npm audit --audit-level=critical",
    "test": "TZ=UTC jest --coverage --verbose",
    "test:watch": "TZ=UTC jest --watch",
    "server:watch": "nodemon --exec \"node --env-file-if-exists=.env ./node_modules/@babel/node/bin/babel-node.js\" ./src",
    "server:debug": "nodemon --exec \"node --inspect=9239 --env-file-if-exists=.env ./node_modules/@babel/node/bin/babel-node.js\" ./src",
    "prestart": "npm run build",
    "start": "NODE_ENV=production node --use-strict --env-file-if-exists=.env ./.server",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1101.0",
    "@babel/runtime": "7.29.7",
    "@elastic/ecs-pino-format": "1.5.0",
    "@graphql-tools/schema": "10.1.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.1",
    "convict": "6.2.5",
    "graphql": "16.14.2",
    "hapi-pino": "13.0.0",
    "joi": "18.2.3",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.5.0",
    "pem-jwk": "2.0.0",
    "pino": "10.3.1",
    "sqs-consumer": "7.5.0"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/node": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "babel-jest": "29.7.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "6.6.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6"
  }
}
