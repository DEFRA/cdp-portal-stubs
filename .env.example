# Local development overrides. Copy to .env (gitignored).
# Loaded via --env-file-if-exists=.env in npm run dev / start.

OIDC_BASE_PATH=/6f504113-6b64-43f2-ade9-242e05780007/v2.0
OIDC_SHOW_LOGIN=true
# Optional. If omitted, stubs generate a random RSA key pair on startup.
# OIDC_PUBLIC_KEY_B64=
# OIDC_PRIVATE_KEY_B64=

SEND_GITHUB_WORKFLOWS_ON_STARTUP=true

SQS_MONOLAMBDA=http://127.0.0.1:4566/000000000000/monolambda
SQS_LAMBDA_EVENTS=http://127.0.0.1:4566/000000000000/lambda-events
SQS_LAMBDA_EVENTS_DELAY_SECONDS=6
SQS_STUB_SLACK_MESSAGES=http://127.0.0.1:4566/000000000000/stub-slack-messages
